<?xml version="1.0" encoding="utf-8"?>
<!-- Chỉ có trong bản debug: màn xem nhanh component dùng chung và màn ở trạng thái chỉ định, để so với thiết kế.
     Mở bằng: adb shell am start -n vn.ggpower.inverter/.debug.ComponentGalleryActivity -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Chỉ bản debug: cho phép HTTP tới backend chạy trên máy dev (10.0.2.2 = máy chủ nhìn từ máy ảo). Bản release chỉ HTTPS. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".debug.ComponentGalleryActivity"
            android:exported="true" />
        <activity
            android:name=".debug.ScreenStateActivity"
            android:exported="true" />
    </application>
</manifest>
