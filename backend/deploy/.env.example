# /opt/ggpower/.env (chmod 600). Never commit real values.
SITE_ADDRESS=your.domain.example
POSTGRES_PASSWORD=change-me
JWT_SIGNING_KEY=at-least-32-random-characters
# The broker in this stack (service "mqtt"); the backend talks to it inside the Docker network.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USER=backend
MQTT_PASSWORD=change-me
MQTT_TENANT=ggp
# true only until an SMS / e-mail provider is connected: one-time codes are written to the API log.
LOG_OTP_CODES=false

# ----- Several API instances (profile "multi", plan B) -----
# File server (SeaweedFS, S3): the API uses these when Storage__Provider=s3. Secret: long random string.
S3_ACCESS_KEY=ggpower
S3_SECRET_KEY=
S3_BUCKET=ggpower
