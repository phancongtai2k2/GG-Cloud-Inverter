# TLS certificates are obtained and renewed automatically for SITE_ADDRESS (a host name pointing at this server).
{$SITE_ADDRESS} {
	encode zstd gzip

	@api path /api/* /ws/* /healthz
	handle @api {
		# One instance by default; several from .env (plan B7): API_UPSTREAMS="api:8080 api2:8080",
		# API_HEALTH_URI=/healthz/ready. An instance that fails the check gets no new requests until it passes again;
		# a request whose instance cannot be reached is tried on another one (rolling restarts). WebSockets need no
		# stickiness: every instance has every device's frames (Redis).
		reverse_proxy {$API_UPSTREAMS:api:8080} {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri {$API_HEALTH_URI:/healthz/live}
			health_interval 5s
			health_timeout 3s
		}
	}

	# Static web site: put files in ./www
	handle {
		root * /srv/www
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
