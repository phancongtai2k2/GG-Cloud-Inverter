# Copy to a file OUTSIDE the repository (run.ps1 reads %LOCALAPPDATA%\ggpower-dev\secrets.env).
PG_APP_PASSWORD=change-me
JWT_SIGNING_KEY=at-least-32-random-bytes
MQTT_HOST=your-broker-host
MQTT_PORT=8883
MQTT_USER=backend-account
MQTT_PASSWORD=change-me
# Tenants to ingest, comma separated. "dev" is the simulator tenant; leave it out in production.
MQTT_TENANTS=ggp
